        <mxCell id="ad4hryZd-CRF8zbJJXat-1" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;b style=&quot;font-size: 13px;&quot;&gt;Keterangan&lt;/b&gt;&lt;span style=&quot;font-size: 13px;&quot;&gt; &amp;nbsp;&amp;nbsp; PK = kunci primer &amp;nbsp;&amp;nbsp; FK = kunci tamu &amp;nbsp;&amp;nbsp; 1 = tepat satu &amp;nbsp;&amp;nbsp; 0..N = nol atau banyak &amp;nbsp;&amp;nbsp; 1..N = satu atau banyak&lt;/span&gt;&lt;br style=&quot;font-size: 13px;&quot;&gt;&lt;i style=&quot;font-size: 13px;&quot;&gt;&lt;font&gt;NULL = kolom boleh kosong • ENUM dan kolom kunci NOT NULL • → tabel = merujuk ke tabel induk • PK,FK = kunci primer komposit sekaligus kunci tamu&lt;br&gt;Pada tabel krs, pasangan (nim_mahasiswa, kode_semester) harus UNIQUE • nilai huruf, total SKS, hari terlambat, dan denda tidak disimpan (turunan)&lt;/font&gt;&lt;/i&gt;" vertex="1">
